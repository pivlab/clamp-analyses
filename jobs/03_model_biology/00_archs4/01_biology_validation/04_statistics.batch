#!/bin/bash
#SBATCH --job-name=archs4_bio_stats
#SBATCH --output=log_ARCHS4_biology_validation_statistics.%j.log
#SBATCH --error=log_ARCHS4_biology_validation_statistics.%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --mem=100GB
#SBATCH --mail-type=ALL
#SBATCH --mail-user=marc.subiranagranes@cuanschutz.edu

MINIFORGE="/pividori_lab/software/miniforge3"
REPO_ROOT="/pividori_lab/marc_projects/clamp-analyses"

source "${MINIFORGE}/etc/profile.d/conda.sh"
source /pividori_lab/marc_projects/conda_env/clamp-analyses/bin/activate

cd "${REPO_ROOT}"

# joblib handles the outer parallelism here.
# Keep threaded math libraries single-threaded inside each worker.
export NUMBA_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

start=$(date +%s)
jupyter nbconvert \
  --to notebook \
  --execute "nbs/03_model_biology/00_archs4/01_biology_validation/04_statistics.ipynb" \
  --ExecutePreprocessor.timeout=-1 \
  --output "04_statistics_executed.ipynb" \
  --output-dir "nbs/03_model_biology/00_archs4/01_biology_validation"
end=$(date +%s)
echo "Elapsed seconds: $((end - start))"
echo "End: $(date)"
