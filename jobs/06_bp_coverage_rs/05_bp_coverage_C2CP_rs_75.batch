#!/bin/bash
#SBATCH --job-name=archs4_c2cp_cov_rs_75
#SBATCH --output=log_ARCHS4_c2cp_coverage_rs_75.%j.log
#SBATCH --error=log_ARCHS4_c2cp_coverage_rs_75.%j.err
#SBATCH --time=800:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=30
#SBATCH --mem=500GB
#SBATCH --mail-type=ALL
#SBATCH --mail-user=marc.subiranagranes@cuanschutz.edu

MINIFORGE="/pividori_lab/software/miniforge3"
source "${MINIFORGE}/etc/profile.d/conda.sh"
source /pividori_lab/marc_projects/conda_env/clamp-analyses/bin/activate

n_jobs=30
export NUMBA_NUM_THREADS=$n_jobs
export MKL_NUM_THREADS=$n_jobs
export OPENBLAS_NUM_THREADS=$n_jobs
export NUMEXPR_NUM_THREADS=$n_jobs
export OMP_NUM_THREADS=$n_jobs

start=$(date +%s)
jupyter nbconvert --to notebook --execute nbs/01_model_building/04_archs4/06_bp_coverage_rs/05_bp_coverage_C2CP_rs_75.ipynb --output 05_bp_coverage_C2CP_rs_75_executed.ipynb
end=$(date +%s)
echo "Elapsed seconds: $((end - start))"
echo "End: $(date)"
