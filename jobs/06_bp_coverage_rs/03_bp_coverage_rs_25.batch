#!/bin/bash
#SBATCH --job-name=archs4_bp_cov_25
#SBATCH --output=log_ARCHS4_bp_coverage_25.%j.log
#SBATCH --error=log_ARCHS4_bp_coverage_25.%j.err
#SBATCH --time=400:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=28
#SBATCH --mem=300GB
#SBATCH --mail-type=ALL
#SBATCH --mail-user=marc.subiranagranes@cuanschutz.edu

MINIFORGE="/pividori_lab/software/miniforge3"
source "${MINIFORGE}/etc/profile.d/conda.sh"
source /pividori_lab/marc_projects/conda_env/clamp-analyses/bin/activate

n_jobs=28
export NUMBA_NUM_THREADS=$n_jobs
export MKL_NUM_THREADS=$n_jobs
export OPENBLAS_NUM_THREADS=$n_jobs
export NUMEXPR_NUM_THREADS=$n_jobs
export OMP_NUM_THREADS=$n_jobs

start=$(date +%s)
jupyter nbconvert --to notebook --execute nbs/01_model_building/04_archs4/06_bp_coverage_rs/03_bp_coverage_rs_25.ipynb --output 03_bp_coverage_rs_25_executed.ipynb
end=$(date +%s)
echo "Elapsed seconds: $((end - start))"
echo "End: $(date)"
