    input:
        rules.pseudobulk_data.input,
        rules.full_models_pseudobulk.input,
        rules.grouped_cv_models_pseudobulk.input,
        rules.single_cell_projections.input,
        rules.model_building_qc_pseudobulk.output.complete,
        rules.biology_pseudobulk.input,
        rules.panels_pseudobulk.input,
