import os

configfile: "workflow/config/pseudobulk.yaml"

# Anchor for repo-root-relative config paths (e.g. notebook locations), so
# they resolve the same way regardless of which included .smk file consumes
# them or what directory snakemake is invoked from -- notebook:/script:
# directives resolve relative paths against the file that defines the rule,
# not against the top-level Snakefile or the invocation cwd.
REPO_ROOT = os.path.dirname(workflow.basedir)

include: "rules/pseudobulk.smk"
include: "rules/panels.smk"

